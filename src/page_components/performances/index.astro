---
import { getSecret } from "astro:env/server";

import MaxWidthContainer from "@/components/_elements/MaxWidthContainer.astro";
import MainLayout from "@/layouts/MainLayout.astro";
import { formatTime } from "@/utils/formatDate";

import styles from "./performances.module.scss";

const apiUrl = getSecret("GIGMANAGER_BASE_URL");
const apiKey = getSecret("GIGMANAGER_API_KEY");
const endpoint = `v1/events/feed?status=5&includes=venue,musicians,project`;

const response = await fetch(`${apiUrl}/${endpoint}`, {
  headers: {
    "x-api-key": apiKey!,
  },
});

const data = await response.json();
---

<MainLayout>
  <MaxWidthContainer>
    <div class={styles["performance-page"]}>
      <h1>Upcoming Performances</h1>

      {
        data?.data?.length > 0 ? (
          <ul id="performance-list" class={styles["performance-list"]}>
            {data.data.map((performance: any) => {
              const eventDate = new Date(performance.eventDate);
              const formattedDate = eventDate.toLocaleDateString("en-us", {
                year: "numeric",
                month: "long",
                day: "numeric",
                timeZone: "UTC",
              });
              const isGypsySwingRevue =
                performance.project.project === "Gypsy Swing Revue";

              return (
                <li class="performance">
                  <div class="performance__datetime">
                    <span class="performance__date">{formattedDate}</span>
                    <span class="performance__time">
                      {formatTime(performance.eventStart)} –
                      {formatTime(performance.eventEnd)}
                    </span>
                  </div>

                  {performance.project?.project ? (
                    isGypsySwingRevue ? (
                      <a
                        class={styles["project"]}
                        href="https://gypsyswingrevue.com"
                      >
                        {performance.project.project}
                      </a>
                    ) : (
                      <p class={styles["project"]}>
                        {performance.project.project}
                      </p>
                    )
                  ) : (
                    ""
                  )}
                  <h3 class="performance__name">{performance.eventName}</h3>

                  {performance.publicEvent ? (
                    performance.venue?.name ? (
                      <p class="performance__venue">
                        {performance.venue.address
                          ? `${performance.venue.address}, `
                          : ""}
                        {performance.venue.state
                          ? `${performance.venue.state} `
                          : ""}
                        {performance.venue.zipcode
                          ? performance.venue.zipcode
                          : ""}
                        {performance.venue.website ? (
                          <a href={performance.venue.website}>
                            {performance.venue.name}
                          </a>
                        ) : (
                          performance.venue.name
                        )}
                      </p>
                    ) : (
                      ""
                    )
                  ) : (
                    <p class="performance__venue performance__venue--private">
                      Private performance
                    </p>
                  )}

                  {performance.eventPrice ? (
                    <p class="performance__price">${performance.eventPrice}</p>
                  ) : (
                    ""
                  )}
                </li>
              );
            })}
          </ul>
        ) : (
          <p>No performances scheduled currently.</p>
        )
      }
    </div>
  </MaxWidthContainer>
</MainLayout>
