---
import { Image } from "astro:assets";
import { getCollection, type CollectionEntry } from "astro:content";

import { capitalize, titleCase } from "@/utils/stringHelpers";
import { deSlugify } from "@/utils/slugify";
import type { CollectionNames } from "@/types/collections";

import Breadcrumbs from "@/components/Breadcrumbs.astro";
import Card from "@/components/elements/Card.astro";
import Heading from "@/components/Heading/Heading";
import MainLayout from "@/layouts/MainLayout.astro";
import Paragraph from "@/components/elements/Paragraph.astro";
import { sortByFrontmatterDataKey } from "@/utils/frontmatter";

const { collectionName } = Astro.props as { collectionName: CollectionNames };
const { category } = Astro.params as { category: string };

const allArticles = (await getCollection(
    collectionName,
)) as CollectionEntry<CollectionNames>[];

const articles = allArticles.filter(
    (article) =>
        article.slug.startsWith(`${category}/`) && article.slug !== category,
);

const sortedArticles = sortByFrontmatterDataKey(articles, "title");

const categoryIndex = allArticles.find((article) => article.slug === category);

let Content:
    | ReturnType<
          Awaited<ReturnType<(typeof categoryIndex)["render"]>>
      >["Content"]
    | undefined = undefined;

if (categoryIndex) {
    const rendered = await categoryIndex.render();
    Content = rendered.Content;
}

const breadcrumbItems = [
    { label: collectionName, href: `/${collectionName}` },
    { label: category, href: `/${collectionName}/${category}` },
];

const categoryTitle = capitalize(category ?? "Default Category");
---

<MainLayout title={titleCase(deSlugify(categoryTitle))}>
    <Breadcrumbs items={breadcrumbItems} />
    <Heading level={1}>{titleCase(deSlugify(categoryTitle))}</Heading>

    {Content && <Content />}

    <ul role="list" class="articles">
        {
            sortedArticles.map((article) => (
                <li>
                    <Card href={`/${collectionName}/${article.slug}`}>
                        {article.data.cover && (
                            <Image
                                class="cover"
                                slot="header"
                                src={article.data.cover}
                                alt={
                                    article.data.coverAltText ??
                                    article.data.title
                                }
                                layout="full-width"
                            />
                        )}
                        <div slot="content" class="content-container">
                            <Heading level={2} size={4}>
                                {article.data.title}
                            </Heading>
                            <Paragraph size="sm">
                                {article.data.description}
                            </Paragraph>
                        </div>
                    </Card>
                </li>
            ))
        }
    </ul>
</MainLayout>

<style lang="scss">
    @use "@/styles/abstracts" as *;

    .cover {
        width: 100%;
        object-fit: cover;
        aspect-ratio: 16 /9;
    }

    .articles {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(px-to-rem(280), 1fr));
        gap: $space-md;
        margin-block: $space-md;
        padding-inline-start: $space-md;
        list-style-type: none;

        li {
            a {
                color: inherit;
                font-weight: $fw-lg;
                text-decoration: none;
            }

            // This counters the Card gap
            .content-container {
                h1,
                h2,
                h3,
                h4,
                h5,
                h6 {
                    margin-block: 0;
                }
            }
        }
    }
</style>
