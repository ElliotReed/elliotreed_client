---
import { getCollection, type CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import Heading from "@/components/Heading/Heading";
import MainLayoutGrid from "@/components/MainLayoutGrid.astro";
import Card from "@/components/UI/Card.astro";
import Paragraph from "@/components/UI/Paragraph.astro";
import MainLayout from "@/layouts/MainLayout.astro";
import TagList from "@/components/TagList.astro";
import { getTags } from "@/utils/getTags";
import { sortByFrontmatterDataKey } from "@/utils/frontmatter";

interface Props {
    collectionName: string;
    title: string;
    description: string;
}

const { collectionName, title, description } = Astro.props;
const maybeArticles = await getCollection(collectionName);
const articles = Array.isArray(maybeArticles)
    ? (maybeArticles as CollectionEntry<typeof collectionName>[])
    : [];

const sortedArticles = sortByFrontmatterDataKey(articles, "title");
---

<MainLayout title={title} description={description}>
    <MainLayoutGrid style="prefered-width">
        <Heading level={1}>{title}</Heading>

        <TagList tags={getTags(articles, "category")} path={collectionName} />

        <ul role="list">
            {
                sortedArticles.map((article) => (
                    <li>
                        <Card href={`/${collectionName}/${article.slug}`}>
                            {article.data.cover && (
                                <Image
                                    class="cover"
                                    slot="header"
                                    src={article.data.cover}
                                    alt={
                                        article.data.coverAltText ??
                                        article.data.title
                                    }
                                    layout="full-width"
                                />
                            )}
                            <div slot="content" class="content-container">
                                <Heading level={3} size={4}>
                                    {article.data.title}
                                </Heading>
                                <Paragraph size="sm">
                                    {article.data.description}
                                </Paragraph>
                            </div>
                        </Card>
                    </li>
                ))
            }
        </ul>
    </MainLayoutGrid>
</MainLayout>

<style lang="scss">
    @use "@/styles/abstracts" as *;
    ul {
        display: grid;
        gap: $space-md;
        grid-template-columns: repeat(auto-fill, minmax(px-to-rem(280), 1fr));
        padding-inline-start: $space-sm;
        list-style: none;

        // This counters the Card gap
        .content-container {
            h1,
            h2,
            h3,
            h4,
            h5,
            h6 {
                margin-block: 0;
            }
        }
    }

    .cover {
        width: 100%;
        object-fit: cover;
        aspect-ratio: 16 / 9;
    }
</style>
