---
import { getCollection, type CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import Heading from "@/components/Heading/Heading";
import MainLayoutGrid from "@/components/MainLayoutGrid.astro";
import Card from "@/components/UI/Card.astro";
import Paragraph from "@/components/UI/Paragraph.astro";
import MainLayout from "@/layouts/MainLayout.astro";

const { collectionName, title, description } = Astro.props;
const articles = await getCollection(collectionName);

// Create a typed map: Record<string, CollectionEntry<"articles">[]>
const grouped: Record<string, CollectionEntry<typeof collectionName>[]> = {};

for (const article of articles) {
    const category = article.data.category;

    // Skip index files (those that don't have a slash in their slug)
    if (!article.slug.includes("/")) {
        continue;
    }

    if (!grouped[category]) {
        grouped[category] = [];
    }

    grouped[category].push(article);
}
---

<MainLayout title={title} description={description}>
    <MainLayoutGrid style="prefered-width">
        <Heading level={1}>{title}</Heading>

        {
            Object.entries(grouped).map(([category, articles]) => (
                <section class="category">
                    <Heading level={2} size={5}>
                        <a
                            class="category-link"
                            href={`/${collectionName}/${category}`}
                        >
                            {category}
                        </a>
                    </Heading>

                    <ul role="list">
                        {articles
                            .sort((a, b) =>
                                a.data.title
                                    .toLowerCase()
                                    .localeCompare(b.data.title.toLowerCase()),
                            )
                            .map((article) => (
                                <li>
                                    <Card
                                        href={`/${collectionName}/${article.slug}`}
                                    >
                                        {article.data.cover && (
                                            <Image
                                                class="cover"
                                                slot="header"
                                                src={article.data.cover}
                                                alt={
                                                    article.data.coverAltText ??
                                                    article.data.title
                                                }
                                                layout="full-width"
                                            />
                                        )}
                                        <div
                                            slot="content"
                                            class="content-container"
                                        >
                                            <Heading level={3} size={4}>
                                                {article.data.title}
                                            </Heading>
                                            <Paragraph size="sm">
                                                {article.data.description}
                                            </Paragraph>
                                        </div>
                                    </Card>
                                </li>
                            ))}
                    </ul>
                </section>
            ))
        }
    </MainLayoutGrid>
</MainLayout>

<style lang="scss">
    @use "@/styles/abstracts" as *;
    .category {
        background: get-color("light", 200);
        border: 1px solid transparent;
        border-radius: $border-radius;

        & > * {
            margin-inline: $space-md;
        }

        & + section {
            margin-block: $space-lg;
        }

        .category-link {
            color: inherit;
            font-family: "Montserrat";
            text-transform: uppercase;

            &:hover,
            &:focus {
                background: get-color("light", 200);
            }

            &:visited {
                color: inherit;
            }
        }

        ul {
            display: grid;
            gap: $space-md;
            grid-template-columns: repeat(
                auto-fill,
                minmax(px-to-rem(280), 1fr)
            );
            padding-inline-start: $space-sm;
            list-style: none;

            // This counters the Card gap
            .content-container {
                h1,
                h2,
                h3,
                h4,
                h5,
                h6 {
                    margin-block: 0;
                }
            }
        }

        .cover {
            width: 100%;
            object-fit: cover;
            aspect-ratio: 16 / 9;
        }
    }
</style>
