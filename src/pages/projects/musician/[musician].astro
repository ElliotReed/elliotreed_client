---
import { getCollection } from "astro:content";
import { slugify } from "@/utils/slugify";
import MainLayout from "@/layouts/MainLayout.astro";
import type { CollectionEntry } from "astro:content";

export async function getStaticPaths() {
    const projects = (await getCollection(
        "projects",
    )) as CollectionEntry<"projects">[];

    const allMusicians = projects.flatMap(
        (project) => project.data.musicians ?? [],
    );
    const uniqueMusicians = [...new Set(allMusicians)];

    return uniqueMusicians.map((musician) => ({
        params: { musician: slugify(musician) },
    }));
}

const { params } = Astro;
const slug = params.musician;

const projects = (await getCollection(
    "projects",
)) as CollectionEntry<"projects">[];

const allMusicians = projects.flatMap(
    (project) => project.data.musicians ?? [],
);
const realMusicianName = allMusicians.find((name) => slugify(name) === slug);
const filteredProjects = realMusicianName
    ? projects.filter((project) =>
          (project.data.musicians ?? []).includes(realMusicianName),
      )
    : [];
---

<MainLayout
    title={`Musician: ${realMusicianName}`}
    description={`Articles tagged with ${realMusicianName}`}
>
    <h1>Projects that include "{realMusicianName}"</h1>
    <ul>
        {
            filteredProjects.map((project) => (
                <li>
                    <a href={`/projects/${slugify(project.data.title)}/`}>
                        {project.data.title}
                    </a>
                </li>
            ))
        }
    </ul>
</MainLayout>
