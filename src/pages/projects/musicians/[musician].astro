---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { slugify } from "@/utils/slugify";
import MainLayout from "@/layouts/MainLayout.astro";
import type { CollectionEntry } from "astro:content";
import Heading from "@/components/Heading/Heading";
import Card from "@/components/elements/Card.astro";
import Paragraph from "@/components/elements/Paragraph.astro";
import TagList from "@/components/TagList.astro";
import { getTags } from "@/utils/getTags";
import ProjectsGrid from "@/components/ProjectsGrid.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";

export async function getStaticPaths() {
    const projects = (await getCollection(
        "projects",
    )) as CollectionEntry<"projects">[];

    const allMusicians = projects.flatMap(
        (project) => project.data.musicians ?? [],
    );
    const uniqueMusicians = [...new Set(allMusicians)];

    return uniqueMusicians.map((musician) => ({
        params: { musician: slugify(musician) },
    }));
}

const { params } = Astro;
const slug = params.musician;

const projects = (await getCollection(
    "projects",
)) as CollectionEntry<"projects">[];

const allMusicians = projects.flatMap(
    (project) => project.data.musicians ?? [],
);
const realMusicianName = allMusicians.find((name) => slugify(name) === slug);
const filteredProjects = realMusicianName
    ? projects.filter((project) =>
          (project.data.musicians ?? []).includes(realMusicianName),
      )
    : [];

const breadcrumbItems = [
    { label: "projects", href: "/projects/" },
    { label: "musicians", href: "/projects/musicians/" },
    { label: `${slug}`, href: `/projects/musicians/${slug}/` },
];
---

<MainLayout
    title={`${realMusicianName} Projects`}
    description={`Projects with ${realMusicianName}`}
>
    <Breadcrumbs items={breadcrumbItems} />

    <h1>Projects that include "{realMusicianName}"</h1>

    <TagList
        tags={getTags(projects, "musicians")}
        path="/projects/musicians/"
        iconName="tabler:brand-netease-music"
        iconLinkPath="/projects/"
        scrollX={true}
    />

    <ProjectsGrid projects={filteredProjects} />
</MainLayout>
