---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

import { getTags } from "@/utils/getTags";

import Breadcrumbs from "@/components/Breadcrumbs.astro";
import MainLayout from "@/layouts/MainLayout.astro";
import MainLayoutGrid from "@/components/MainLayoutGrid.astro";
import TagList from "@/components/TagList.astro";

const projects: CollectionEntry<"projects">[] = await getCollection("projects");
const breadcrumbs = [
    { label: "projects", href: "/projects/" },
    { label: "styles", href: "/projects/styles" },
];
---

<MainLayout title="Styles" description="List of styles.">
    <Breadcrumbs items={breadcrumbs} />
    <MainLayoutGrid style={"prefered-width"}>
        <TagList
            tags={getTags(projects, "styles")}
            title="styles"
            path="/projects/styles/"
            size="lg"
        />
    </MainLayoutGrid>
</MainLayout>
