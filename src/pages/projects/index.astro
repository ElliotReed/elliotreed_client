---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import Heading from "@/components/Heading/Heading";
import MainLayoutGrid from "@/components/MainLayoutGrid.astro";
import Card from "@/components/elements/Card.astro";
import Paragraph from "@/components/elements/Paragraph.astro";
import MainLayout from "@/layouts/MainLayout.astro";
import { slugify } from "@/utils/slugify";
import TagList from "@/components/TagList.astro";
import { getTags } from "@/utils/getTags";
import ProjectsGrid from "@/components/ProjectsGrid.astro";

const projects = (await getCollection(
    "projects",
)) as CollectionEntry<"projects">[];
---

<MainLayout title="Projects" description="Projects">
    <MainLayoutGrid style="prefered-width">
        <Heading level={1}>Projects</Heading>

        <TagList
            tags={getTags(projects, "musicians")}
            path="/projects/musician/"
            iconName="tabler:brand-netease-music"
            iconLinkPath="/projects/musicians/"
            scrollX={true}
            title="Musicians"
        />

        <TagList
            tags={getTags(projects, "styles")}
            path="/projects/style/"
            iconName="tabler:file-music"
            iconLinkPath="/projects/styles/"
            title="Styles"
        />

        <ProjectsGrid projects={projects} />
    </MainLayoutGrid>
</MainLayout>
