---
import { getCollection, type CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import Heading from "@/components/Heading/Heading";
import MainLayoutGrid from "@/components/MainLayoutGrid.astro";
import Card from "@/components/UI/Card.astro";
import Paragraph from "@/components/UI/Paragraph.astro";
import MainLayout from "@/layouts/MainLayout.astro";
import { slugify } from "@/utils/slugify";
import TagList from "@/components/TagList.astro";
import { getTags } from "@/utils/getTags";

const projects = (await getCollection(
    "projects",
)) as CollectionEntry<"projects">[];
---

<MainLayout title="Projects" description="Projects">
    <MainLayoutGrid style="prefered-width">
        <Heading level={1}>Projects</Heading>
        <TagList
            tags={getTags(projects, "musicians")}
            path="/projects/musician/"
            iconName="tabler:brand-netease-music"
            iconLinkPath="/projects/"
        />
        <TagList
            tags={getTags(projects, "styles")}
            path="/projects/style/"
            iconName="tabler:file-music"
            iconLinkPath="/projects/"
        />
        <ul role="list">
            {
                projects
                    .sort((a, b) =>
                        a.data.title
                            .toLowerCase()
                            .localeCompare(b.data.title.toLowerCase()),
                    )
                    .map((project) => (
                        <li>
                            <Card
                                href={`/projects/${slugify(project.data.title)}/`}
                            >
                                {project.data.cover && (
                                    <Image
                                        class="cover"
                                        slot="header"
                                        src={project.data.cover}
                                        alt={
                                            project.data.coverAltText ??
                                            project.data.title
                                        }
                                        layout="full-width"
                                    />
                                )}
                                <div slot="content" class="content-container">
                                    <Heading level={3} size={4}>
                                        {project.data.title}
                                    </Heading>
                                    <Paragraph size="sm">
                                        {project.data.description}
                                    </Paragraph>
                                </div>
                            </Card>
                        </li>
                    ))
            }
        </ul>
    </MainLayoutGrid>
</MainLayout>

<style lang="scss">
    @use "@/styles/abstracts" as *;

    ul {
        display: grid;
        gap: $space-md;
        grid-template-columns: repeat(auto-fill, minmax(px-to-rem(280), 1fr));
        padding-inline-start: $space-sm;
        list-style: none;

        // This counters the Card gap
        .content-container {
            h1,
            h2,
            h3,
            h4,
            h5,
            h6 {
                margin-block: 0;
            }
        }
    }

    .cover {
        width: 100%;
        object-fit: cover;
        aspect-ratio: 16 / 9;
    }
</style>
