---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

import { Icon } from "astro-icon/components";

import { categoryList } from "@/data/category";
import { getTags } from "@/utils/getTags";
import { slugify } from "@/utils/slugify";
import {
    getEntryFilename,
    sortCollectionByDate,
} from "@/utils/collectionHelpers";

import Heading from "@/components/Heading/Heading";
import TagList from "@/components/TagList.astro";
import MainLayout from "@/layouts/MainLayout.astro";
import Card from "@/components/elements/Card.astro";
import Paragraph from "@/components/elements/Paragraph.astro";

const notes: CollectionEntry<"notes">[] = await getCollection("notes");
const categories = categoryList.map((category) => category.id);
const sortedNotes = sortCollectionByDate(notes);

const tags = getTags(notes, "tags");
---

<MainLayout
    title="Notes"
    description="A collection of my personal notes on music."
>
    <Heading level={1} hidden>
        <Icon name="tabler:file-music" />
        Notes
    </Heading>

    <div class="space"></div>

    <TagList
        tags={categories}
        path="/notes/categories/"
        iconName="tabler:category"
        title="Categories"
        size="md"
    />

    <TagList size="md" tags={tags} path="/notes/tags/" title="Tags" />

    <ul role="list">
        {
            sortedNotes.map((note) => (
                <li>
                    <Card href={`/notes/${getEntryFilename(note)}/`}>
                        {note.data.cover && (
                            <Image
                                class="cover"
                                slot="header"
                                src={note.data.cover}
                                alt={note.data.coverAltText ?? note.data.title}
                                layout="full-width"
                            />
                        )}
                        <div slot="content" class="content-container">
                            <Heading level={3} size={4}>
                                {note.data.title}
                            </Heading>
                            <Paragraph size="sm">
                                {note.data.description}
                            </Paragraph>
                        </div>
                    </Card>
                </li>
            ))
        }
    </ul>
</MainLayout>

<style lang="scss">
    @use "@/styles/abstracts" as *;
    @use "sass:color" as color;

    .space {
        height: $space-md;
    }

    ul {
        display: grid;
        gap: $space-md;
        grid-template-columns: repeat(auto-fill, minmax(px-to-rem(280), 1fr));
        padding-inline-start: $space-sm;
        list-style: none;

        // This counters the Card gap
        .content-container {
            h1,
            h2,
            h3,
            h4,
            h5,
            h6 {
                margin-block: 0;
            }
        }
    }

    .cover {
        width: 100%;
        object-fit: cover;
        aspect-ratio: 16 / 9;
    }
</style>
