---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

import { Icon } from "astro-icon/components";

import { categoryList } from "@/data/category";
import { getTags } from "@/utils/getTags";
import { sortCollectionByDate } from "@/utils/collectionHelpers";

import Heading from "@/components/Heading/Heading";
import TagList from "@/components/TagList.astro";
import MainLayout from "@/layouts/MainLayout.astro";
import NotesGrid from "@/components/NotesGrid.astro";

const notes: CollectionEntry<"notes">[] = await getCollection("notes");
const categories = categoryList.map((category) => category.id);
const sortedNotes = sortCollectionByDate(notes);

const tags = getTags(notes, "tags");
---

<MainLayout
    title="Notes"
    description="A collection of my personal notes on music."
>
    <Heading level={1} hidden>
        <Icon name="tabler:file-music" />
        Notes
    </Heading>

    <div class="space"></div>

    <TagList
        tags={categories}
        path="/notes/categories/"
        iconName="tabler:category"
        title="Categories"
        size="md"
    />

    <TagList
        size="md"
        tags={tags}
        path="/notes/tags/"
        title="Tags"
        scrollX={true}
    />

    <NotesGrid notes={sortedNotes} />
</MainLayout>

<style lang="scss">
    @use "@/styles/abstracts" as *;

    .space {
        height: $space-md;
    }
</style>
