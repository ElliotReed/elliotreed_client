---
import Heading from "@/components/Heading/Heading";
import MainLayout from "@/layouts/MainLayout.astro";
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import { slugify } from "@/utils/slugify";
import MainLayoutGrid from "@/components/MainLayoutGrid.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import { getEntryFilename } from "@/utils/collectionHelpers";

export async function getStaticPaths() {
    const notes: CollectionEntry<"notes">[] = await getCollection("notes");
    const categories = [
        ...new Set(notes.map((note) => slugify(note.data.category))),
    ];
    return categories.map((category) => ({
        params: {
            category: category,
        },
    }));
}

const { category } = Astro.params;
const notes: CollectionEntry<"notes">[] = await getCollection("notes");

const filteredNotes = notes.filter(
    (note) => slugify(note.data.category) === category,
);

const breadcrumbs = [
    { label: "notes", href: "/notes/" },
    { label: `categories`, href: `/notes/categories/` },
    { label: `${category}`, href: `/notes/categories/${category}/` },
];
---

<MainLayout title={category} description={category}>
    <Breadcrumbs items={breadcrumbs} />
    <MainLayoutGrid style={"prefered-width"}>
        <Heading level={1}>{category}</Heading>
        {
            filteredNotes.map((note) => (
                <Heading level={2}>
                    <a href={`/notes/${getEntryFilename(note)}/`}>
                        {note.data.title}
                    </a>
                </Heading>
            ))
        }
    </MainLayoutGrid>
</MainLayout>
