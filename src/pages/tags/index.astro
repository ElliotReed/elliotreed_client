---
import { getCollection } from "astro:content";

import { slugify } from "@/utils/slugify";

import MainLayout from "@/layouts/MainLayout.astro";
import MainLayoutGrid from "@/components/MainLayoutGrid.astro";
import TagList from "@/components/TagList.astro";
import { getTags } from "@/utils/getTags";

const collections = [
    "composition",
    "guitar",
    "notation",
    "recording",
    "singing",
];

const allArticles = await Promise.all(
    collections.map((collection) => getCollection(collection)),
);
const articles = allArticles.flat();
---

<MainLayout title="Tags" description="A list of all tags used in the blog.">
    <MainLayoutGrid style="prefered-width">
        <h1>Tags</h1>
        <p>Explore articles by tags.</p>
        <TagList
            tags={getTags(articles, "tags")}
            path="/tags"
            iconName="tabler:tag"
            iconLinkPath="/tags"
        />
    </MainLayoutGrid>
</MainLayout>
