---
import { getCollection } from "astro:content";
import { slugify } from "@/utils/slugify";
import { Image } from "astro:assets";
import MainLayout from "@/layouts/MainLayout.astro";
import Card from "@/components/UI/Card.astro";
import Heading from "@/components/Heading/Heading";
import Paragraph from "@/components/UI/Paragraph.astro";
import { sortByFrontmatterDataKey } from "@/utils/frontmatter";

const collections = [
    "composition",
    "guitar",
    "notation",
    "recording",
    "singing",
];

export async function getStaticPaths() {
    // Collections must be duplicated in getStaticPaths, it runs in an isolated sourceMapsEnabled.
    const collections = [
        "composition",
        "guitar",
        "notation",
        "recording",
        "singing",
    ];

    const allArticles = await Promise.all(
        collections.map((c) => getCollection(c)),
    );
    const articles = allArticles.flat();

    const allTags = articles.flatMap((a) => a.data.tags ?? []);
    const uniqueTags = [...new Set(allTags)];

    return uniqueTags.map((tag) => ({
        params: { tag: slugify(tag) },
    }));
}

const { params } = Astro;
const slug = params.tag;

const allArticles = await Promise.all(collections.map((c) => getCollection(c)));
const articles = allArticles.flat();

const allTags = articles.flatMap((a) => a.data.tags ?? []);
const realTag = allTags.find((t) => slugify(t) === slug);

const filteredArticles = realTag
    ? articles.filter((a) => (a.data.tags ?? []).includes(realTag))
    : [];

const sortedFilteredArticles = sortByFrontmatterDataKey(
    filteredArticles,
    "title",
);
---

<MainLayout
    title={`Tag: ${realTag ?? slug}`}
    description={`Articles tagged with ${realTag ?? slug}`}
>
    <h1>Articles tagged with "{realTag ?? slug}"</h1>
    {
        filteredArticles.length === 0 ? (
            <p>No articles found with this tag.</p>
        ) : (
            <ul role="list" class="articles">
                {sortedFilteredArticles.map((article) => (
                    <li>
                        <Card href={`/${article.collection}/${article.slug}/`}>
                            {article.data.cover && (
                                <Image
                                    class="cover"
                                    slot="header"
                                    src={article.data.cover}
                                    alt={article.data.title}
                                    layout="full-width"
                                />
                            )}
                            <div slot="content" class="content-container">
                                <Heading level={2} size={4}>
                                    {article.data.title}
                                </Heading>
                                <Paragraph size="sm">
                                    {article.data.description}
                                </Paragraph>
                            </div>
                        </Card>
                    </li>
                ))}
            </ul>
        )
    }
</MainLayout>

<style lang="scss">
    @use "@/styles/abstracts" as *;

    .cover {
        width: 100%;
        object-fit: cover;
        aspect-ratio: 16 /9;
    }

    .articles {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(px-to-rem(280), 1fr));
        gap: $space-md;
        margin-block: $space-md;
        padding-inline-start: $space-md;
        list-style-type: none;

        li {
            a {
                color: inherit;
                font-weight: $fw-lg;
                text-decoration: none;
            }

            // This counters the Card gap
            .content-container {
                h1,
                h2,
                h3,
                h4,
                h5,
                h6 {
                    margin-block: 0;
                }
            }
        }
    }
</style>
