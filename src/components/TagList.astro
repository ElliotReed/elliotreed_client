---
import { slugify } from "@/utils/slugify";
import { Icon } from "astro-icon/components";

interface Props {
    tags: string[];
    path?: string;
    iconName?: string;
    iconLinkPath?: string;
    size?: "sm" | "md" | "lg";
    title?: string;
    scrollX?: boolean;
    scrollY?: boolean;
}

const {
    iconLinkPath,
    iconName = "tabler:tag",
    path,
    size = "sm",
    tags,
    title = null,
    scrollX = false,
    scrollY = false,
} = Astro.props;
let tagPath = path || "/tags/";
tagPath = tagPath.endsWith("/") ? tagPath : tagPath + "/";

const sortedTags = tags.sort((a, b) =>
    a.toLowerCase().localeCompare(b.toLowerCase()),
);

const iconSize = "1.25em";
---

<div class:list={["tag-component", size]}>
    {
        title && (
            <a
                class="tag-component__title-link"
                href={iconLinkPath ? iconLinkPath : tagPath}
            >
                <Icon name={iconName} size={iconSize} />
                <span class="tag-component__title">{title}</span>
            </a>
        )
    }
    <div class="tag-component__links">
        {
            !title && (
                <a href={iconLinkPath ? iconLinkPath : tagPath}>
                    <Icon name={iconName} size={iconSize} />
                </a>
            )
        }
        <ul
            class:list={[
                "tag-list",
                scrollX && "scroll-x",
                scrollY && "scroll-y",
            ]}
        >
            {
                Array.isArray(tags) &&
                    sortedTags.map((tag) => (
                        <li>
                            <a href={`${tagPath}${slugify(tag)}/`}>{tag}</a>
                        </li>
                    ))
            }
        </ul>
    </div>
</div>
