---
import { Icon } from "astro-icon/components";
import NavigationHeaderLink from "@/components/NavigationHeaderLink.astro";

interface Link {
    content: string;
    address: string;
    subLinks?: Link[];
}

interface Props {
    links: Link[];
}
const { links } = Astro.props;
---

<nav class="primary-nav">
    <ul class="primary nav-list">
        {
            links.map((link) => (
                <>
                    <li>
                        <NavigationHeaderLink to={link.address}>
                            {link.content === "Notes" ? (
                                <span>
                                    <Icon name="tabler:music" />
                                </span>
                            ) : null}
                            {link.content}
                        </NavigationHeaderLink>
                    </li>
                </>
            ))
        }
    </ul>
</nav>

<style lang="scss">
    @use "sass:color";
    @use "@/styles/abstracts" as *;

    .nav-list {
        display: flex;
        flex-direction: column;
        flex-wrap: wrap;
        justify-content: center;
        margin: 0;
        padding: 0;
        list-style: none;

        @include respond-to("sm") {
            flex-wrap: nowrap;
            flex-direction: row;
        }

        li {
            position: relative;
            display: flex;
            align-items: center;
            min-width: fit-content;
            color: get-color("mainBrand");

            // Navigation header link has child that has .active class
            &:has(li .active) {
                color: get-color("lightShades");
                background: get-color("darkShades", 300);
            }
        }
    }
</style>
