{
    "extends": "astro/tsconfigs/strict",
    "compilerOptions": {
        "jsx": "react-jsx",
        "jsxImportSource": "react",
        "paths": {
            "@/*": [
                "./src/*"
            ],
        },
    },
    "include": [
        "src/**/*",
        ".astro/types.d.ts",
        "src/content.config.ts"
    ],
    "exclude": [
        ".hidden",
        "dist",
    ]
}