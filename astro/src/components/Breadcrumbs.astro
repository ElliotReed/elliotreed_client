---
import { Icon } from "astro-icon/components";

export interface Breadcrumb {
    label: string;
    href: string;
}

const { items = [] }: { items?: Breadcrumb[] } = Astro.props;
---

<nav aria-label="breadcrumb" class="">
    <ul role="list" class="">
        <li>
            <a href="/" class=""><Icon name="tabler:home" /></a>
        </li>
        {
            items.map((item, i) => (
                <li class="">
                    <span>/</span>
                    <a href={item.href} class="">
                        {item.label}
                    </a>
                </li>
            ))
        }
    </ul>
</nav>

<style lang="scss">
    @use "@/styles/abstracts" as *;
    nav {
        margin-block: $space-md;
        font-size: $fs-md-rem;

        ul {
            display: flex;
            margin: 0;
            padding: 0;
        }

        li {
            display: flex;
            align-items: center;
            list-style: none;

            a {
                padding-inline: em-scale(100);
                font-weight: $fw-md;
                text-decoration: none;
                background: get-color("light", 300);
                border-radius: $border-radius;
                cursor: pointer;

                &:hover {
                    text-decoration: underline;
                }
            }
        }
    }
</style>
